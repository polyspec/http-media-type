{
  "name": "@polyspec/http-media-type",
  "version": "0.0.1",
  "description": "The http-media-type library of polyspec for Node and the browser",
  "license": "MIT",
  "type": "module",
  "main": "./generated/index.cjs",
  "types": "./generated/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./wasm/generated/index.d.ts",
        "default": "./wasm/generated/index.mjs"
      },
      "types": "./generated/index.d.ts",
      "import": "./generated/index.mjs",
      "require": "./generated/index.cjs"
    },
    "./wasm": {
      "types": "./wasm/generated/index.d.ts",
      "default": "./wasm/generated/index.mjs"
    }
  },
  "files": [
    "generated/index.cjs",
    "generated/index.mjs",
    "generated/index.d.ts",
    "wasm/generated/*.mjs",
    "wasm/generated/*.js",
    "wasm/generated/*.d.ts",
    "wasm/generated/*.wasm"
  ],
  "napi": {
    "binaryName": "http-media-type",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  }
}
