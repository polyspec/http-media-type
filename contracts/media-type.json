{
  "parse": [
    { "id": "a_media_type_gives_its_type_subtype_and_parameters", "label": "a media type gives its type and subtype in lower case and its unquoted parameters", "rules": ["MT-1.2", "MT-2.2", "MT-3.4", "MT-4.1", "MT-4.4"], "value": "Text/HTML; Charset=\"UTF-8\"", "media_type": {"type": "text", "subtype": "html", "parameters": [{"name": "charset", "value": "UTF-8"}]} },
    { "id": "a_media_type_without_parameters_has_an_empty_list", "label": "a media type without parameters has the empty list", "rules": ["MT-4.4"], "value": "application/json", "media_type": {"type": "application", "subtype": "json", "parameters": []} },
    { "id": "the_parameters_keep_their_order", "label": "the parameters keep the order of the value", "rules": ["MT-3.6"], "value": "application/vnd.example+json;version=2;charset=utf-8", "media_type": {"type": "application", "subtype": "vnd.example+json", "parameters": [{"name": "version", "value": "2"}, {"name": "charset", "value": "utf-8"}]} },
    { "id": "white_space_around_the_value_is_ignored", "label": "spaces and tabs around the value are ignored", "rules": ["MT-1.3"], "value": " \ttext/html ; level=1\t ", "media_type": {"type": "text", "subtype": "html", "parameters": [{"name": "level", "value": "1"}]} },
    { "id": "a_trailing_semicolon_is_an_empty_parameter", "label": "a trailing semicolon is an empty parameter", "rules": ["MT-3.2"], "value": "text/html;", "media_type": {"type": "text", "subtype": "html", "parameters": []} },
    { "id": "obs_text_in_a_quoted_value_is_kept", "label": "a byte above 0x7F in a quoted value is kept", "rules": ["MT-1.1", "MT-3.3"], "value": "text/plain;x=\"é\"", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "x", "value": "é"}]} },
    { "id": "the_any_type_is_invalid", "label": "*/* is no media type", "rules": ["MT-4.2"], "value": "*/*", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_type_range_is_invalid", "label": "text/* is no media type", "rules": ["MT-4.2"], "value": "text/*", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_q_parameter_is_invalid", "label": "a parameter named q fails", "rules": ["MT-4.3"], "value": "text/html;Q=0.5", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_duplicate_parameter_is_invalid", "label": "two parameters of one name fail", "rules": ["MT-3.5"], "value": "text/plain;charset=utf-8;CHARSET=utf-8", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_missing_subtype_is_invalid", "label": "a type without a subtype fails", "rules": ["MT-4.1"], "value": "text", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "an_empty_value_is_invalid", "label": "the empty value is no media type", "rules": ["MT-4.1"], "value": "", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_list_is_invalid", "label": "a comma after a media type fails", "rules": ["MT-4.1"], "value": "text/html, text/plain", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "an_unterminated_quoted_string_is_invalid", "label": "a quoted string without its closing quote fails", "rules": ["MT-3.3"], "value": "multipart/form-data; boundary=\"abc", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "text_after_a_parameter_is_invalid", "label": "text after a parameter value without a semicolon fails", "rules": ["MT-4.1"], "value": "text/html;a=b c", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_parameter_without_a_value_is_invalid", "label": "a parameter without = fails", "rules": ["MT-3.1"], "value": "text/html;charset", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_quoted_value_unquotes_its_pairs", "label": "a quoted value loses its quotes and the backslash of each quoted pair", "rules": ["MT-3.3", "MT-3.4"], "value": "text/plain;a=\"b\\\"c\\\\d\\e\"", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "b\"c\\de"}]} },
    { "id": "a_quoted_token_reads_as_the_token", "label": "a quoted token reads as the same token unquoted", "rules": ["MT-3.4"], "value": "text/plain;format=\"flowed\"", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "format", "value": "flowed"}]} },
    { "id": "an_empty_quoted_value_is_the_empty_value", "label": "a quoted string of no byte is the empty value", "rules": ["MT-3.3", "MT-3.4"], "value": "text/plain;a=\"\"", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": ""}]} },
    { "id": "a_quoted_value_keeps_spaces_tabs_and_separators", "label": "a quoted value keeps SP, HTAB, comma, semicolon and equals sign", "rules": ["MT-3.3"], "value": "multipart/form-data; boundary=\"a b\tc,d;e=f\"", "media_type": {"type": "multipart", "subtype": "form-data", "parameters": [{"name": "boundary", "value": "a b\tc,d;e=f"}]} },
    { "id": "obs_text_after_a_backslash_is_kept", "label": "a byte above 0x7F after a backslash is the byte", "rules": ["MT-1.1", "MT-3.3", "MT-3.4"], "value": "text/plain;a=\"\\ÿ\"", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "ÿ"}]} },
    { "id": "every_tchar_is_a_token_value", "label": "a value of every tchar is a token", "rules": ["MT-2.1", "MT-3.1"], "value": "text/plain;a=!#$%&'*+-.^_`|~09AZaz", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "!#$%&'*+-.^_`|~09AZaz"}]} },
    { "id": "a_token_that_holds_a_star_names_a_type", "label": "a token that holds * but is not * names a type", "rules": ["MT-2.1", "MT-4.2"], "value": "te*t/h*ml", "media_type": {"type": "te*t", "subtype": "h*ml", "parameters": []} },
    { "id": "a_parameter_named_like_q_is_a_parameter", "label": "a parameter whose name only starts with q is a parameter", "rules": ["MT-4.3"], "value": "text/html;qq=1", "media_type": {"type": "text", "subtype": "html", "parameters": [{"name": "qq", "value": "1"}]} },
    { "id": "empty_parameters_and_the_white_space_around_semicolons_give_nothing", "label": "empty parameters and SP and HTAB around semicolons give nothing", "rules": ["MT-3.2"], "value": "text/html \t; ;a=1 ;;\tb=2;", "media_type": {"type": "text", "subtype": "html", "parameters": [{"name": "a", "value": "1"}, {"name": "b", "value": "2"}]} },
    { "id": "names_and_value_case", "label": "names are read in lower case and a value keeps its case", "rules": ["MT-1.2", "MT-2.2", "MT-5.3"], "value": "TEXT/PLAIN;FORMAT=Flowed", "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "format", "value": "Flowed"}]} },
    { "id": "a_wildcard_subtype_is_invalid", "label": "text/* is no media type, also as *", "rules": ["MT-4.2"], "value": "*/html", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_lower_case_q_is_invalid", "label": "a parameter named q fails in lower case too", "rules": ["MT-4.3"], "value": "text/html;q=1", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_duplicate_parameter_with_a_quoted_value_is_invalid", "label": "a parameter given twice fails whatever its quoting", "rules": ["MT-3.5"], "value": "text/plain;charset=utf-8;charset=\"utf-8\"", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_missing_type_is_invalid", "label": "a value that starts with the slash fails", "rules": ["MT-4.1"], "value": "/html", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "an_empty_subtype_is_invalid", "label": "a slash without a subtype fails", "rules": ["MT-4.1"], "value": "text/", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_second_slash_is_invalid", "label": "a second slash after the subtype fails", "rules": ["MT-4.1"], "value": "text/html/x", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_space_around_the_slash_is_invalid", "label": "a space between the type and the slash fails", "rules": ["MT-4.1"], "value": "text /html", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "parameters_without_a_type_are_invalid", "label": "parameters alone are no media type", "rules": ["MT-4.1"], "value": ";charset=utf-8", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_value_of_white_space_is_invalid", "label": "a value of SP and HTAB is empty after MT-1.3", "rules": ["MT-1.3", "MT-4.1"], "value": " \t ", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_space_before_the_equal_sign_is_invalid", "label": "a space before = fails", "rules": ["MT-3.1"], "value": "text/html;a =1", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_space_after_the_equal_sign_is_invalid", "label": "a space after = fails", "rules": ["MT-3.1"], "value": "text/html;a= 1", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "an_empty_parameter_value_is_invalid", "label": "= with no value fails", "rules": ["MT-3.1"], "value": "text/html;a=", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_quoted_parameter_name_is_invalid", "label": "a parameter name is a token, not a quoted string", "rules": ["MT-3.1"], "value": "text/html;\"a\"=1", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_quote_after_a_token_value_is_invalid", "label": "a quote after a token value fails", "rules": ["MT-3.1", "MT-4.1"], "value": "text/html;a=b\"c\"", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "text_after_a_quoted_value_is_invalid", "label": "a byte after the closing quote other than ; fails", "rules": ["MT-3.1", "MT-4.1"], "value": "text/html;a=\"b\"c", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_backslash_at_the_end_of_a_quoted_string_is_invalid", "label": "a backslash before the end leaves the quoted string open", "rules": ["MT-3.3"], "value": "text/html;a=\"b\\\"", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_control_byte_in_a_quoted_string_is_invalid", "label": "a control byte is no qdtext", "rules": ["MT-3.3"], "value": "text/html;a=\"b\u0001\"", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_quoted_delete_is_invalid", "label": "DEL is neither qdtext nor the byte of a quoted pair", "rules": ["MT-3.3"], "value": "text/html;a=\"\\\"", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_quoted_line_feed_is_invalid", "label": "a line feed is neither qdtext nor the byte of a quoted pair", "rules": ["MT-3.3"], "value": "text/html;a=\"b\\\n\"", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "obs_text_in_a_token_is_invalid", "label": "a byte above 0x7F is no tchar in a type", "rules": ["MT-2.1", "MT-1.1"], "value": "téxt/html", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "obs_text_in_a_token_value_is_invalid", "label": "a byte above 0x7F is no tchar in a token value", "rules": ["MT-2.1", "MT-3.1"], "value": "text/html;a=é", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_line_feed_after_the_value_is_invalid", "label": "a line feed is no whitespace of MT-1.3", "rules": ["MT-1.3"], "value": "text/html\n", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_nul_byte_after_the_value_is_invalid", "label": "a NUL byte is no whitespace of MT-1.3", "rules": ["MT-1.3"], "value": "text/html\u0000", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_no_break_space_before_the_value_is_invalid", "label": "the byte 0xA0 is no whitespace of MT-1.3", "rules": ["MT-1.3"], "value": " text/html", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_comma_after_the_parameters_is_invalid", "label": "a comma after the parameters fails, also after an empty parameter", "rules": ["MT-3.2", "MT-4.1"], "value": "text/html;a=1;,", "raises": {"kind": "malformed_media_type", "status": null, "category": "value", "message": null} }
  ],
  "format": [
    { "id": "a_media_type_without_parameters", "label": "a media type without parameters is its type and subtype", "rules": ["MT-6.1"], "media_type": {"type": "application", "subtype": "json", "parameters": []}, "text": "application/json" },
    { "id": "each_parameter_follows_a_semicolon_and_a_space", "label": "each parameter follows ; and one SP, in order", "rules": ["MT-6.1", "MT-3.6"], "media_type": {"type": "application", "subtype": "vnd.example+json", "parameters": [{"name": "version", "value": "2"}, {"name": "charset", "value": "utf-8"}]}, "text": "application/vnd.example+json; version=2; charset=utf-8" },
    { "id": "names_are_written_in_lower_case", "label": "type, subtype and names are written in lower case and a value keeps its case", "rules": ["MT-6.2", "MT-6.3", "MT-2.2"], "media_type": {"type": "Text", "subtype": "HTML", "parameters": [{"name": "Charset", "value": "UTF-8"}]}, "text": "text/html; charset=UTF-8" },
    { "id": "a_token_value_is_written_unquoted", "label": "a token value has no quotes", "rules": ["MT-6.3", "MT-2.1"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "!#$%&'*+-.^_`|~09AZaz"}]}, "text": "text/plain; a=!#$%&'*+-.^_`|~09AZaz" },
    { "id": "the_empty_value_is_quoted", "label": "the empty value is a quoted string", "rules": ["MT-6.3"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": ""}]}, "text": "text/plain; a=\"\"" },
    { "id": "a_value_with_separators_is_quoted", "label": "a value with SP, comma, semicolon, equals sign or slash is quoted", "rules": ["MT-6.3"], "media_type": {"type": "multipart", "subtype": "form-data", "parameters": [{"name": "boundary", "value": "a b,c;d=e/f"}]}, "text": "multipart/form-data; boundary=\"a b,c;d=e/f\"" },
    { "id": "quote_and_backslash_are_escaped", "label": "only quote and backslash get a backslash", "rules": ["MT-6.3"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "b\"c\\d\te"}]}, "text": "text/plain; a=\"b\\\"c\\\\d\te\"" },
    { "id": "obs_text_is_quoted_without_a_backslash", "label": "a byte above 0x7F is quoted and needs no backslash", "rules": ["MT-6.3", "MT-1.1"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "é"}]}, "text": "text/plain; a=\"é\"" },
    { "id": "a_token_that_holds_a_star_is_written", "label": "a type that holds * but is not * is written", "rules": ["MT-6.4", "MT-4.2"], "media_type": {"type": "te*t", "subtype": "h*ml", "parameters": []}, "text": "te*t/h*ml" },
    { "id": "a_charset_value_is_not_rewritten", "label": "a charset value keeps its case", "rules": ["MT-6.3", "MT-5.2"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "charset", "value": "UTF-8"}]}, "text": "text/plain; charset=UTF-8" },
    { "id": "an_empty_type_is_invalid", "label": "the empty type is no token", "rules": ["MT-6.4"], "media_type": {"type": "", "subtype": "html", "parameters": []}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_type_with_a_space_is_invalid", "label": "a type with SP is no token", "rules": ["MT-6.4"], "media_type": {"type": "text ", "subtype": "html", "parameters": []}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_subtype_with_a_slash_is_invalid", "label": "a subtype with a slash is no token", "rules": ["MT-6.4"], "media_type": {"type": "text", "subtype": "html/x", "parameters": []}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "obs_text_in_a_type_is_invalid", "label": "a byte above 0x7F is no tchar", "rules": ["MT-6.4", "MT-2.1"], "media_type": {"type": "téxt", "subtype": "html", "parameters": []}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "the_wildcard_type_is_invalid", "label": "* is no type of a media type", "rules": ["MT-6.4", "MT-4.2"], "media_type": {"type": "*", "subtype": "*", "parameters": []}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "the_wildcard_subtype_is_invalid", "label": "* is no subtype of a media type", "rules": ["MT-6.4", "MT-4.2"], "media_type": {"type": "text", "subtype": "*", "parameters": []}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "an_empty_name_is_invalid", "label": "the empty name is no token", "rules": ["MT-6.4"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "", "value": "1"}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_name_with_an_equal_sign_is_invalid", "label": "a name with = is no token", "rules": ["MT-6.4"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a=b", "value": "1"}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "the_name_q_is_invalid", "label": "a parameter named q cannot be written, in any case", "rules": ["MT-6.4", "MT-4.3"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "Q", "value": "1"}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "two_names_equal_without_case_are_invalid", "label": "two names equal without regard to case fail", "rules": ["MT-6.4", "MT-3.5"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "1"}, {"name": "A", "value": "2"}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_nul_byte_in_a_value_is_invalid", "label": "NUL cannot stand in a quoted string", "rules": ["MT-6.4", "MT-3.3"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "b\u0000"}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_line_feed_in_a_value_is_invalid", "label": "a line feed cannot stand in a quoted string", "rules": ["MT-6.4", "MT-3.3"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": "b\nc"}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} },
    { "id": "a_delete_in_a_value_is_invalid", "label": "DEL cannot stand in a quoted string", "rules": ["MT-6.4", "MT-3.3"], "media_type": {"type": "text", "subtype": "plain", "parameters": [{"name": "a", "value": ""}]}, "raises": {"kind": "invalid_media_type", "status": null, "category": "value", "message": null} }
  ],
  "sameValue": [
    { "id": "equal_bytes_are_the_same_value", "label": "equal bytes are the same value", "rules": ["MT-5.1"], "name": "version", "left": "2", "right": "2", "same": true },
    { "id": "the_empty_values_are_the_same", "label": "two empty values are the same value", "rules": ["MT-5.1"], "name": "a", "left": "", "right": "", "same": true },
    { "id": "another_parameter_compares_with_case", "label": "a value of another parameter compares its bytes with case", "rules": ["MT-5.3"], "name": "format", "left": "Flowed", "right": "flowed", "same": false },
    { "id": "charset_values_compare_without_case", "label": "charset values compare without regard to ASCII case", "rules": ["MT-5.2"], "name": "charset", "left": "UTF-8", "right": "utf-8", "same": true },
    { "id": "the_charset_name_compares_without_case", "label": "the name charset is compared without case", "rules": ["MT-5.2", "MT-2.2"], "name": "CharSet", "left": "ISO-8859-1", "right": "iso-8859-1", "same": true },
    { "id": "different_charsets_differ", "label": "two charsets of different bytes differ", "rules": ["MT-5.2"], "name": "charset", "left": "utf-8", "right": "utf-16", "same": false },
    { "id": "obs_text_case_counts_in_a_charset", "label": "the case of a byte above 0x7F is no ASCII case", "rules": ["MT-5.2", "MT-1.1"], "name": "charset", "left": "É", "right": "é", "same": false },
    { "id": "a_name_that_only_holds_charset_compares_with_case", "label": "a name other than charset compares exactly", "rules": ["MT-5.4"], "name": "charsets", "left": "UTF-8", "right": "utf-8", "same": false }
  ]
}
